set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.1.1.3/31
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.1.2.3/31
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 type bridged
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.0.12/32
set / interface irb0 admin-state enable
set / interface irb0 subinterface 10 admin-state enable
set / interface irb0 subinterface 10 ipv4 admin-state enable
set / interface irb0 subinterface 10 ipv4 address 10.10.10.1/24 anycast-gw true
set / interface irb0 subinterface 10 ipv4 arp learn-unsolicited true
set / interface irb0 subinterface 10 ipv4 arp host-route populate dynamic
set / interface irb0 subinterface 10 ipv4 arp evpn advertise dynamic
set / interface irb0 subinterface 10 anycast-gw anycast-gw-mac 00:00:5e:00:01:01
set / tunnel-interface vxlan1 vxlan-interface 10 type bridged
set / tunnel-interface vxlan1 vxlan-interface 10 ingress vni 10010
set / tunnel-interface vxlan1 vxlan-interface 10 egress source-ip use-system-ipv4-address
set / tunnel-interface vxlan1 vxlan-interface 2 type routed
set / tunnel-interface vxlan1 vxlan-interface 2 ingress vni 50001
set / tunnel-interface vxlan1 vxlan-interface 2 egress source-ip use-system-ipv4-address
set / network-instance default type default
set / network-instance default admin-state enable
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface system0.0
set / network-instance MACVRF10 type mac-vrf
set / network-instance MACVRF10 admin-state enable
set / network-instance MACVRF10 interface ethernet-1/3.0
set / network-instance MACVRF10 interface irb0.10
set / network-instance MACVRF10 vxlan-interface vxlan1.10
set / network-instance MACVRF10 protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance MACVRF10 protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.10
set / network-instance MACVRF10 protocols bgp-evpn bgp-instance 1 evi 10
set / network-instance MACVRF10 protocols bgp-evpn bgp-instance 1 ecmp 2
set / network-instance MACVRF10 protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:10010
set / network-instance MACVRF10 protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:10010
set / network-instance TENANT type ip-vrf
set / network-instance TENANT admin-state enable
set / network-instance TENANT interface irb0.10
set / network-instance TENANT vxlan-interface vxlan1.2
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.2
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 evi 2
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 ecmp 2
set / network-instance TENANT protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:50001
set / network-instance TENANT protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:50001
set / routing-policy prefix-set LEAF-LOCAL prefix 10.255.0.12/32 mask-length-range exact
set / routing-policy policy LEAF-EXPORT statement 10 match prefix prefix-set LEAF-LOCAL
set / routing-policy policy LEAF-EXPORT statement 10 match protocol local
set / routing-policy policy LEAF-EXPORT statement 10 action policy-result accept
set / routing-policy policy LEAF-EXPORT default-action policy-result reject
set / routing-policy policy ACCEPT-ALL default-action policy-result accept
set / bfd subinterface ethernet-1/1.0 admin-state enable
set / bfd subinterface ethernet-1/1.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/1.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/1.0 detection-multiplier 3
set / bfd subinterface ethernet-1/2.0 admin-state enable
set / bfd subinterface ethernet-1/2.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/2.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/2.0 detection-multiplier 3
set / network-instance default protocols bgp autonomous-system 65002
set / network-instance default protocols bgp router-id 10.255.0.12
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath ebgp maximum-paths 2
set / network-instance default protocols bgp afi-safi evpn admin-state enable
set / network-instance default protocols bgp group SPINES afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group SPINES import-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp group SPINES export-policy [ LEAF-EXPORT ]
set / network-instance default protocols bgp group SPINES timers hold-time 9
set / network-instance default protocols bgp group SPINES timers keepalive-interval 3
set / network-instance default protocols bgp group EVPN afi-safi evpn admin-state enable
set / network-instance default protocols bgp group EVPN afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group EVPN import-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp group EVPN export-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp group EVPN multihop admin-state enable
set / network-instance default protocols bgp group EVPN multihop maximum-hops 5
set / network-instance default protocols bgp group EVPN transport local-address 10.255.0.12
set / network-instance default protocols bgp group EVPN timers connect-retry 10
set / network-instance default protocols bgp neighbor 10.1.1.2 peer-group SPINES
set / network-instance default protocols bgp neighbor 10.1.1.2 peer-as 65100
set / network-instance default protocols bgp neighbor 10.1.1.2 failure-detection enable-bfd true
set / network-instance default protocols bgp neighbor 10.1.2.2 peer-group SPINES
set / network-instance default protocols bgp neighbor 10.1.2.2 peer-as 65100
set / network-instance default protocols bgp neighbor 10.1.2.2 failure-detection enable-bfd true
set / network-instance default protocols bgp neighbor 10.255.0.1 peer-group EVPN
set / network-instance default protocols bgp neighbor 10.255.0.1 peer-as 65100
set / network-instance default protocols bgp neighbor 10.255.0.2 peer-group EVPN
set / network-instance default protocols bgp neighbor 10.255.0.2 peer-as 65100

