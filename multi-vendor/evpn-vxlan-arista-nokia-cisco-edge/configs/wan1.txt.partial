hostname wan1
!
interface Loopback0
 description simulated-internet-target
 ip address 203.0.113.1 255.255.255.255
!
interface Ethernet0/1
 description leaf1-VRF-TENANT
 ip address 172.16.255.1 255.255.255.252
 no shutdown
!
router bgp 65500
 bgp router-id 203.0.113.1
 bgp log-neighbor-changes
 neighbor 172.16.255.2 remote-as 65001
 neighbor 172.16.255.2 description leaf1-TENANT
 !
 address-family ipv4
  neighbor 172.16.255.2 activate
  neighbor 172.16.255.2 default-originate
 exit-address-family
!
end

