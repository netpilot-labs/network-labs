hostname spine1
service routing protocols model multi-agent
ip routing
!
interface Ethernet1/1
   description leaf1
   no switchport
   mtu 9214
   ip address 10.1.1.0/31
   bfd interval 300 min-rx 300 multiplier 3
!
interface Ethernet1/2
   description leaf2
   no switchport
   mtu 9214
   ip address 10.1.1.2/31
   bfd interval 300 min-rx 300 multiplier 3
!
interface Loopback0
   ip address 10.255.0.1/32
!
router bgp 65100
   router-id 10.255.0.1
   no bgp default ipv4-unicast
   maximum-paths 4 ecmp 4
   neighbor UNDERLAY peer group
   neighbor UNDERLAY timers 3 9
   neighbor UNDERLAY bfd
   neighbor EVPN peer group
   neighbor EVPN update-source Loopback0
   neighbor EVPN ebgp-multihop 5
   neighbor EVPN send-community extended
   neighbor 10.1.1.1 peer group UNDERLAY
   neighbor 10.1.1.1 remote-as 65001
   neighbor 10.1.1.3 peer group UNDERLAY
   neighbor 10.1.1.3 remote-as 65002
   neighbor 10.255.0.11 peer group EVPN
   neighbor 10.255.0.11 remote-as 65001
   neighbor 10.255.0.12 peer group EVPN
   neighbor 10.255.0.12 remote-as 65002
   network 10.255.0.1/32
   !
   address-family evpn
      neighbor EVPN activate
      neighbor EVPN next-hop-unchanged
   !
   address-family ipv4
      neighbor UNDERLAY activate
!
end

