username admin privilege 15 role network-admin secret <set-a-password>
ip routing
hostname EDGE
!
interface Loopback0
 ip address 10.255.0.4/32
!
interface Ethernet1/1
 no switchport
 ip address 10.0.14.2/30
 ip ospf network point-to-point
!
interface Ethernet1/2
 no switchport
 ip address 10.0.34.2/30
 ip ospf network point-to-point
!
interface Ethernet1/3
 no switchport
 ip address 10.0.4.1/24
!
router ospf 1
 router-id 10.255.0.4
 passive-interface Ethernet1/3
 network 10.0.14.0/30 area 0
 network 10.0.34.0/30 area 0
 network 10.0.4.0/24 area 0
 network 10.255.0.4/32 area 0
!
