configure terminal
hostname R3
interface eth1
 ip address 10.2.3.2/30
exit
interface lo
 ip address 3.3.3.3/32
exit
route-map ALLOW-ALL permit 10
exit
router bgp 65003
 bgp router-id 3.3.3.3
 neighbor 10.2.3.1 remote-as 65002
 address-family ipv4 unicast
  network 3.3.3.3/32
  neighbor 10.2.3.1 route-map ALLOW-ALL in
  neighbor 10.2.3.1 route-map ALLOW-ALL out
 exit-address-family
exit
end
write file
